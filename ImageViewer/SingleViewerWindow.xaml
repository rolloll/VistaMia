<Window x:Class="ImageViewer.SingleViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Vista Mia" Height="720" Width="640"
        MinHeight="300" MinWidth="360"
        Icon="pack://application:,,,/Resources/icon.ico"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/icon.ico" Width="16" Height="16"/>
                <TextBlock x:Name="TitleText" Text="Vista Mia" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Content="&#x2500;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#x25A1;" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#x2715;" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Flat menu bar -->
        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="FileMenuButton" Style="{StaticResource MenuItemButtonStyle}" Click="FileMenuButton_Click">
                    <TextBlock Text="파일"/>
                </ToggleButton>
                <ToggleButton x:Name="ExifMenuButton" Style="{StaticResource MenuItemButtonStyle}" Click="ExifMenuButton_Click">
                    <TextBlock Text="EXIF"/>
                </ToggleButton>
                <ToggleButton x:Name="HdrToggleButton" Style="{StaticResource MenuItemButtonStyle}" Click="HdrToggleButton_Click">
                    <TextBlock Text="HDR"/>
                </ToggleButton>
                <ToggleButton x:Name="ImageMenuButton" Style="{StaticResource MenuItemButtonStyle}" Click="ImageMenuButton_Click">
                    <TextBlock Text="이미지"/>
                </ToggleButton>
                <ToggleButton x:Name="SlideshowButton" Style="{StaticResource MenuItemButtonStyle}" Click="SlideshowButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SlideshowIcon" Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SlideshowLabel" Text="슬라이드 쇼"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="LibraryButton" Style="{StaticResource MenuItemButtonStyle}" Click="LibraryButton_Click">
                    <TextBlock Text="사진 보관함"/>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- Image canvas -->
        <Grid Grid.Row="2" Background="{StaticResource BgBrush}">
            <ScrollViewer x:Name="PreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel">
                <Image x:Name="PreviewImage"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                       MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                       MouseMove="PreviewImage_MouseMove">
                    <Image.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="PreviewRotateTransform" Angle="0"/>
                        </TransformGroup>
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>

            <TextBlock x:Name="EmptyStateText"
                       Text="이미지를 불러올 수 없습니다"
                       Foreground="{StaticResource TextFaintBrush}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Floating settings button -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                <Button x:Name="SettingsButton" Content="&#x2699;" Style="{StaticResource OverlayCircleButtonStyle}"
                        FontSize="18" ToolTip="설정" Click="SettingsButton_Click"/>
                <Ellipse x:Name="SettingsBadge" Width="10" Height="10" Fill="{StaticResource Accent2Brush}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                         Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <!-- Prev/next navigation -->
            <Button x:Name="PrevButton" Content="&#x2039;" Style="{StaticResource OverlayCircleButtonStyle}"
                    ToolTip="이전 이미지" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                    Click="PrevButton_Click"/>
            <Button x:Name="NextButton" Content="&#x203A;" Style="{StaticResource OverlayCircleButtonStyle}"
                    ToolTip="다음 이미지" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                    Click="NextButton_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14">
                <Border Background="{StaticResource OverlayInkStrongBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,5">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource BgBrush}" FontSize="12"/>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,5" Margin="6,0,0,0">
                    <TextBlock x:Name="ZoomLabelText" Foreground="{StaticResource Accent700Brush}" FontSize="12"/>
                </Border>
            </StackPanel>

            <!-- EXIF flyout -->
            <Border x:Name="ExifPanel" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="{StaticResource RadiusLg}" Padding="16,18" MaxWidth="320"
                    Effect="{StaticResource ShadowMd}">
                <StackPanel>
                    <TextBlock Text="파일 정보" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ExifText" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Image (rotate) flyout -->
            <Border x:Name="ImagePanel" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="{StaticResource RadiusLg}" Padding="10"
                    Effect="{StaticResource ShadowMd}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="왼쪽으로 회전" Style="{StaticResource SecondaryButton}" Margin="2" Click="RotateLeftButton_Click"/>
                    <Button Content="오른쪽으로 회전" Style="{StaticResource SecondaryButton}" Margin="2" Click="RotateRightButton_Click"/>
                    <Button Content="원본 크기 맞춤" Style="{StaticResource SecondaryButton}" Margin="2" Click="FitButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Settings flyout -->
            <Border x:Name="SettingsPanel" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,16,0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="{StaticResource RadiusLg}" Padding="16" Width="220"
                    Effect="{StaticResource ShadowMd}">
                <StackPanel>
                    <TextBlock Text="설정" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="슬라이드 쇼 간격(초)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <Slider x:Name="SlideshowIntervalSlider" Minimum="1" Maximum="10" Value="3"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SlideshowIntervalSlider_ValueChanged"/>
                    <TextBlock x:Name="SlideshowIntervalText" Text="3초" FontSize="11" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
