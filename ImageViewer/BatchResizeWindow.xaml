<Window x:Class="ImageViewer.BatchResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Vista Mia" Height="500" Width="440"
        MinHeight="460" MinWidth="400"
        Icon="pack://application:,,,/Resources/icon.ico"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/icon.ico" Width="16" Height="16"/>
                <TextBlock Text="이미지 일괄 리사이즈" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Content="&#x2500;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#x2715;" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20,16,20,20">
            <TextBlock x:Name="SourceCountText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="크기" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WidthTextBox" Grid.Column="0" ToolTip="가로" TextChanged="WidthTextBox_TextChanged"/>
                <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"/>
                <TextBox x:Name="HeightTextBox" Grid.Column="2" ToolTip="세로" TextChanged="HeightTextBox_TextChanged"/>
                <ComboBox x:Name="UnitCombo" Grid.Column="4" SelectedIndex="0" SelectionChanged="UnitCombo_SelectionChanged">
                    <ComboBoxItem Content="px"/>
                    <ComboBoxItem Content="cm"/>
                    <ComboBoxItem Content="mm"/>
                </ComboBox>
            </Grid>
            <TextBlock x:Name="PrimaryHintText" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="DPI (cm/mm → px 변환 기준)" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="DpiTextBox" Width="70" Text="96"/>
            </StackPanel>

            <CheckBox x:Name="IgnoreAspectCheckBox" Content="비율 무시 (가로/세로를 입력한 값으로 정확히 맞춤)" Margin="0,0,0,18"
                      Checked="IgnoreAspectCheckBox_Changed" Unchecked="IgnoreAspectCheckBox_Changed"/>

            <TextBlock Text="저장 폴더" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestPathTextBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="찾아보기..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseDestButton_Click"/>
            </Grid>

            <ProgressBar x:Name="Progress" Height="6" Margin="0,0,0,16"/>

            <Button x:Name="RunButton" Content="리사이즈 실행" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="RunButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
