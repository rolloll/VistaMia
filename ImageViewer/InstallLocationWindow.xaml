<Window x:Class="ImageViewer.InstallLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Vista Mia" Height="260" Width="480"
        MinHeight="260" MinWidth="420"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/icon.ico"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/icon.ico" Width="16" Height="16"/>
                <TextBlock Text="Vista Mia 설치" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Content="&#x2500;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#x2715;" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,20,24,20">
            <TextBlock Text="Vista Mia를 설치할 폴더를 선택하세요" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="선택한 폴더에 프로그램 파일이 복사되고, 앞으로 자동 업데이트도 이 폴더에 적용됩니다."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="찾아보기..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseButton_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="나중에" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SkipButton_Click"/>
                <Button Grid.Column="2" Content="설치" Style="{StaticResource PrimaryButton}" Click="InstallButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
